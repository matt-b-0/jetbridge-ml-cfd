# OpenFOAM: generated case output (leave initial 0/ and dictionaries tracked)
cfd/cases/**/processor*/
cfd/cases/**/postProcessing/
cfd/cases/**/constant/polyMesh/
cfd/cases/**/VTK/
cfd/cases/**/log.*
cfd/cases/**/[1-9]/
cfd/cases/**/[1-9][0-9]*/
cfd/cases/**/core
# Originals inside previously generated OpenFOAM case are not to be committed
cfd/cases/**/data/source/*

# Regenerated Word authoring output; retain final deliverables separately
/docs/report/*_output/
